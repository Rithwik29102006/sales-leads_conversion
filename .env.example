# Copy this file to ".env" (same folder) and fill in your own values.
# Never share the real .env file or put it in your report/PPT.

# ---- Twilio WhatsApp (Console -> Account Info) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Meta WhatsApp Cloud API (only if you use Meta directly) ----
WHATSAPP_VERIFY_TOKEN=leadai-verify-token
WHATSAPP_APP_SECRET=

# ---- Email (optional): secret for /webhook/email?token=... ----
EMAIL_WEBHOOK_TOKEN=
